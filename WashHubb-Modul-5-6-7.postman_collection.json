{
  "info": {
    "name": "WashHubb — Modul 5, 6, 7",
    "description": "Testing API Operasional Laundry, Franchise, Dashboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "outlet_id", "value": "1" },
    { "key": "order_id", "value": "" },
    { "key": "permintaan_id", "value": "" },
    { "key": "distribusi_id", "value": "" },
    { "key": "jadwal_service_id", "value": "" },
    { "key": "jadwal_shift_id", "value": "" },
    { "key": "loyalti_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@washubb.com\",\n  \"password\": \"password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  console.log('Token saved:', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5.1 Order Cucian",
      "item": [
        {
          "name": "List Order",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/operasional/orders?page=1", "host": ["{{base_url}}"], "path": ["operasional", "orders"], "query": [{ "key": "page", "value": "1" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Buat Order",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/operasional/orders", "host": ["{{base_url}}"], "path": ["operasional", "orders"] },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outlet_id\": {{outlet_id}},\n  \"jenis_layanan_id\": 1,\n  \"detail_mesin_id\": 1,\n  \"berat\": 5.5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('order_id', json.data.id);",
                  "  console.log('Order ID saved:', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail Order",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/operasional/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["operasional", "orders", "{{order_id}}"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Selesai Order",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/operasional/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["operasional", "orders", "{{order_id}}"] },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"selesai\"\n}"
            }
          }
        },
        {
          "name": "Batalkan Order",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/operasional/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["operasional", "orders", "{{order_id}}"] },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dibatalkan\",\n  \"alasan_pembatalan\": \"Mesin rusak mendadak\"\n}"
            }
          }
        }
      ]
    },
    {
